# Copy to .env:  cp .env.example .env   (Windows: copy .env.example .env)
# One .env at the REPO ROOT is used by all days. Never commit .env.

APP_NAME=PoshanGuide
APP_ENV=development

# Day 1 + later: limits used by the sugar/salt rule checks (grams per day)
SUGAR_LIMIT_G=25
SALT_LIMIT_G=5
SUGAR_PER_TSP_G=4

# Day 3: API server + search
HOST=127.0.0.1
PORT=8000
SEARCH_TOP_K=5

# Day 4: downloads
REQUEST_TIMEOUT=30

# Later GenAI days (leave blank until needed; never share or commit a real key)
# ANTHROPIC_API_KEY=
