# Copy this file to .env and paste your own key. NEVER commit .env
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# lowest similarity score a chunk needs to be shown to the model (optional)
# RAG_MIN_SCORE=0.20

# needed only to call POST /search/reindex on a public server (leave empty to keep it disabled)
# ADMIN_TOKEN=choose_a_long_random_text
